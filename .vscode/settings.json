{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/build/**": true,
    "**/.dart_tool/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/build/**": true,
    "**/.dart_tool/**": true
  },
  "javascript.validate.enable": false,
  "typescript.validate.enable": false,
  "dart.analysisExcludedFolders": [
    "build"
  ]
}
